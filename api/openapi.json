{
  "components": {
    "schemas": {
      "ApplyLDIFInputBody": {
        "additionalProperties": false,
        "properties": {
          "ldif": {
            "description": "Content or change records (add, modify, delete); URL values are not allowed",
            "maxLength": 10485760,
            "minLength": 1,
            "type": "string"
          },
          "stopOnError": {
            "type": "boolean"
          }
        },
        "required": [
          "ldif"
        ],
        "type": "object"
      },
      "ApplyResult": {
        "additionalProperties": false,
        "properties": {
          "dn": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "op": {
            "enum": [
              "add",
              "modify",
              "delete"
            ],
            "type": "string"
          }
        },
        "required": [
          "dn",
          "op"
        ],
        "type": "object"
      },
      "ApplySummary": {
        "additionalProperties": false,
        "properties": {
          "applied": {
            "format": "int64",
            "type": "integer"
          },
          "failed": {
            "format": "int64",
            "type": "integer"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ApplyResult"
            },
            "type": "array"
          }
        },
        "required": [
          "applied",
          "failed",
          "results"
        ],
        "type": "object"
      },
      "Attribute": {
        "additionalProperties": false,
        "properties": {
          "binary": {
            "description": "Values are base64-encoded",
            "type": "boolean"
          },
          "name": {
            "description": "Attribute description as returned by the server, including options such as ;lang-ru",
            "type": "string"
          },
          "operational": {
            "type": "boolean"
          },
          "redacted": {
            "description": "Values are password hashes reduced to their {SCHEME}",
            "type": "boolean"
          },
          "values": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "values"
        ],
        "type": "object"
      },
      "AttributeType": {
        "additionalProperties": false,
        "properties": {
          "collective": {
            "type": "boolean"
          },
          "desc": {
            "type": "string"
          },
          "equality": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "string",
              "integer",
              "boolean",
              "dn",
              "time",
              "binary",
              "octet",
              "password"
            ],
            "type": "string"
          },
          "maxLen": {
            "format": "int64",
            "type": "integer"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "noUserModification": {
            "type": "boolean"
          },
          "obsolete": {
            "type": "boolean"
          },
          "oid": {
            "type": "string"
          },
          "ordering": {
            "type": "string"
          },
          "origin": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "singleValue": {
            "type": "boolean"
          },
          "substr": {
            "type": "string"
          },
          "sup": {
            "type": "string"
          },
          "syntax": {
            "description": "Syntax OID, inherited from SUP if not set",
            "type": "string"
          },
          "usage": {
            "enum": [
              "userApplications",
              "directoryOperation",
              "distributedOperation",
              "dSAOperation"
            ],
            "type": "string"
          }
        },
        "required": [
          "oid",
          "names",
          "kind"
        ],
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "certs": {
            "description": "Management of the NSS certificate database",
            "type": "boolean"
          },
          "files": {
            "description": "Access to logs, LDIF and backup files",
            "type": "boolean"
          },
          "ldapAuth": {
            "description": "How ds-ui authenticates to the server",
            "enum": [
              "sasl-external",
              "simple",
              "anonymous"
            ],
            "type": "string"
          },
          "lifecycle": {
            "description": "Server process control (restart/stop/start)",
            "enum": [
              "docker",
              "s6",
              "none"
            ],
            "type": "string"
          },
          "mode": {
            "enum": [
              "sidecar",
              "remote",
              "aio"
            ],
            "type": "string"
          },
          "offline": {
            "description": "Offline database operations (dsctl)",
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "ldapAuth",
          "lifecycle",
          "files",
          "certs",
          "offline"
        ],
        "type": "object"
      },
      "Change": {
        "additionalProperties": false,
        "properties": {
          "attr": {
            "minLength": 1,
            "type": "string"
          },
          "binary": {
            "description": "Values are base64-encoded",
            "type": "boolean"
          },
          "op": {
            "description": "delete without values removes the attribute",
            "enum": [
              "add",
              "delete",
              "replace"
            ],
            "type": "string"
          },
          "values": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "op",
          "attr"
        ],
        "type": "object"
      },
      "ChildrenPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Summary"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "Pass as cursor to get the next page",
            "type": "string"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "DeleteResult": {
        "additionalProperties": false,
        "properties": {
          "deleted": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "deleted"
        ],
        "type": "object"
      },
      "Entry": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "items": {
              "$ref": "#/components/schemas/Attribute"
            },
            "type": "array"
          },
          "dn": {
            "type": "string"
          },
          "etag": {
            "description": "Version of the user attributes; send as If-Match when modifying",
            "type": "string"
          },
          "hasChildren": {
            "type": "boolean"
          },
          "numSubordinates": {
            "format": "int64",
            "type": "integer"
          },
          "objectClasses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parent": {
            "type": "string"
          },
          "rdn": {
            "type": "string"
          }
        },
        "required": [
          "dn",
          "rdn",
          "parent",
          "objectClasses",
          "attributes",
          "numSubordinates",
          "hasChildren",
          "etag"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Field": {
        "additionalProperties": false,
        "properties": {
          "default": {
            "description": "May reference other fields as {attr}; {next:attr} is the next free number",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "ModifyInputBody": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "changes"
        ],
        "type": "object"
      },
      "NewEntry": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "items": {
              "$ref": "#/components/schemas/NewValues"
            },
            "minItems": 1,
            "type": "array"
          },
          "dn": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "dn",
          "attributes"
        ],
        "type": "object"
      },
      "NewValues": {
        "additionalProperties": false,
        "properties": {
          "binary": {
            "type": "boolean"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "values": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "name",
          "values"
        ],
        "type": "object"
      },
      "NextNumberOutputBody": {
        "additionalProperties": false,
        "properties": {
          "value": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "ObjectClass": {
        "additionalProperties": false,
        "properties": {
          "desc": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "structural",
              "auxiliary",
              "abstract"
            ],
            "type": "string"
          },
          "may": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "must": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "obsolete": {
            "type": "boolean"
          },
          "oid": {
            "type": "string"
          },
          "origin": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sup": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "oid",
          "names",
          "kind",
          "must",
          "may"
        ],
        "type": "object"
      },
      "PasswordRequest": {
        "additionalProperties": false,
        "properties": {
          "dn": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "description": "New password; empty asks the server to generate one",
            "type": "string"
          }
        },
        "required": [
          "dn"
        ],
        "type": "object"
      },
      "PasswordResult": {
        "additionalProperties": false,
        "properties": {
          "generated": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RenameRequest": {
        "additionalProperties": false,
        "properties": {
          "deleteOldRdn": {
            "description": "Remove the old RDN value from the entry",
            "type": "boolean"
          },
          "dn": {
            "minLength": 1,
            "type": "string"
          },
          "newParent": {
            "description": "New parent DN; empty keeps the current parent",
            "type": "string"
          },
          "newRdn": {
            "description": "New RDN, e.g. uid=newname (may equal the current RDN when only moving)",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "dn",
          "newRdn",
          "deleteOldRdn"
        ],
        "type": "object"
      },
      "RenameResult": {
        "additionalProperties": false,
        "properties": {
          "dn": {
            "type": "string"
          }
        },
        "required": [
          "dn"
        ],
        "type": "object"
      },
      "ReplaceLDIFInputBody": {
        "additionalProperties": false,
        "properties": {
          "ldif": {
            "description": "One content record for the same DN",
            "maxLength": 10485760,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "ldif"
        ],
        "type": "object"
      },
      "Schema": {
        "additionalProperties": false,
        "properties": {
          "attributeTypes": {
            "items": {
              "$ref": "#/components/schemas/AttributeType"
            },
            "type": "array"
          },
          "objectClasses": {
            "items": {
              "$ref": "#/components/schemas/ObjectClass"
            },
            "type": "array"
          },
          "syntaxes": {
            "items": {
              "$ref": "#/components/schemas/Syntax"
            },
            "type": "array"
          }
        },
        "required": [
          "attributeTypes",
          "objectClasses",
          "syntaxes"
        ],
        "type": "object"
      },
      "SearchHit": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "items": {
              "$ref": "#/components/schemas/Attribute"
            },
            "type": "array"
          },
          "dn": {
            "type": "string"
          }
        },
        "required": [
          "dn",
          "attributes"
        ],
        "type": "object"
      },
      "SearchRequest": {
        "additionalProperties": false,
        "properties": {
          "attrs": {
            "description": "Attributes to return; empty returns all user attributes",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "base": {
            "minLength": 1,
            "type": "string"
          },
          "filter": {
            "default": "(objectClass=*)",
            "type": "string"
          },
          "limit": {
            "default": 500,
            "format": "int64",
            "maximum": 5000,
            "minimum": 1,
            "type": "integer"
          },
          "scope": {
            "default": "sub",
            "enum": [
              "base",
              "one",
              "sub"
            ],
            "type": "string"
          }
        },
        "required": [
          "base",
          "scope",
          "filter"
        ],
        "type": "object"
      },
      "SearchResult": {
        "additionalProperties": false,
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            },
            "type": "array"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "entries",
          "truncated"
        ],
        "type": "object"
      },
      "ServerInfo": {
        "additionalProperties": false,
        "properties": {
          "boundAs": {
            "description": "Identity ds-ui is bound as",
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "dbImplementation": {
            "description": "Database implementation (LMDB or Berkeley DB)",
            "enum": [
              "mdb",
              "bdb",
              ""
            ],
            "type": "string"
          },
          "defaultNamingContext": {
            "type": "string"
          },
          "namingContexts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supportedControls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supportedExtensions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supportedSaslMechanisms": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "vendor": {
            "type": "string"
          },
          "vendorVersion": {
            "type": "string"
          },
          "version": {
            "description": "Parsed product version, e.g. 3.1.2",
            "type": "string"
          }
        },
        "required": [
          "vendor",
          "vendorVersion",
          "version",
          "namingContexts",
          "supportedControls",
          "supportedExtensions",
          "supportedSaslMechanisms",
          "boundAs"
        ],
        "type": "object"
      },
      "Summary": {
        "additionalProperties": false,
        "properties": {
          "dn": {
            "type": "string"
          },
          "exists": {
            "description": "False for a naming context whose root entry has not been created yet",
            "type": "boolean"
          },
          "hasChildren": {
            "type": "boolean"
          },
          "numSubordinates": {
            "format": "int64",
            "type": "integer"
          },
          "objectClasses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rdn": {
            "type": "string"
          },
          "system": {
            "description": "Server-internal tree such as cn=config",
            "type": "boolean"
          }
        },
        "required": [
          "dn",
          "rdn",
          "objectClasses",
          "numSubordinates",
          "hasChildren",
          "exists"
        ],
        "type": "object"
      },
      "Syntax": {
        "additionalProperties": false,
        "properties": {
          "desc": {
            "type": "string"
          },
          "oid": {
            "type": "string"
          }
        },
        "required": [
          "oid"
        ],
        "type": "object"
      },
      "SystemInfo": {
        "additionalProperties": false,
        "properties": {
          "instance": {
            "description": "389 instance name",
            "type": "string"
          },
          "server": {
            "$ref": "#/components/schemas/ServerInfo"
          },
          "uiVersion": {
            "type": "string"
          }
        },
        "required": [
          "instance",
          "uiVersion",
          "server"
        ],
        "type": "object"
      },
      "SystemState": {
        "additionalProperties": false,
        "properties": {
          "ldap": {
            "description": "Result of an LDAP round-trip",
            "enum": [
              "ok",
              "unreachable",
              "error"
            ],
            "type": "string"
          },
          "ldapError": {
            "type": "string"
          },
          "restartRequired": {
            "description": "A setting changed that only applies after restart",
            "type": "boolean"
          },
          "server": {
            "description": "Process state from the lifecycle provider",
            "enum": [
              "running",
              "stopped",
              "restarting",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "ldap",
          "server",
          "restartRequired"
        ],
        "type": "object"
      },
      "Template": {
        "additionalProperties": false,
        "properties": {
          "custom": {
            "description": "The user chooses object classes and the RDN attribute",
            "type": "boolean"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/Field"
            },
            "type": "array"
          },
          "icon": {
            "enum": [
              "user",
              "group",
              "folder",
              "entry"
            ],
            "type": "string"
          },
          "id": {
            "description": "Stable identifier; UI texts live under templates.\u003cid\u003e in the locale files",
            "type": "string"
          },
          "objectClasses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "password": {
            "description": "Ask for an initial userPassword",
            "type": "boolean"
          },
          "rdn": {
            "description": "Naming attribute",
            "type": "string"
          }
        },
        "required": [
          "id",
          "icon",
          "objectClasses",
          "rdn",
          "fields"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Administration API for 389 Directory Server.",
    "title": "389-ds-ui API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/entries": {
      "delete": {
        "operationId": "deleteEntry",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "dn",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Also delete all descendants (at most 10000 entries)",
            "explode": false,
            "in": "query",
            "name": "subtree",
            "schema": {
              "description": "Also delete all descendants (at most 10000 entries)",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Delete an entry, optionally with its subtree",
        "tags": [
          "entries"
        ]
      },
      "get": {
        "operationId": "getEntry",
        "parameters": [
          {
            "description": "Distinguished name of the entry",
            "explode": false,
            "in": "query",
            "name": "dn",
            "required": true,
            "schema": {
              "description": "Distinguished name of the entry",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            },
            "description": "OK",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Read one entry with user and operational attributes",
        "tags": [
          "entries"
        ]
      },
      "patch": {
        "operationId": "modifyEntry",
        "parameters": [
          {
            "explode": false,
            "in": "query",
            "name": "dn",
