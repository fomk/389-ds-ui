{
  "components": {
    "schemas": {
      "Attribute": {
        "additionalProperties": false,
        "properties": {
          "binary": {
            "description": "Values are base64-encoded",
            "type": "boolean"
          },
          "name": {
            "description": "Attribute description as returned by the server, including options such as ;lang-ru",
            "type": "string"
          },
          "operational": {
            "type": "boolean"
          },
          "redacted": {
            "description": "Values are password hashes reduced to their {SCHEME}",
            "type": "boolean"
          },
          "values": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "values"
        ],
        "type": "object"
      },
      "AttributeType": {
        "additionalProperties": false,
        "properties": {
          "collective": {
            "type": "boolean"
          },
          "desc": {
            "type": "string"
          },
          "equality": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "string",
              "integer",
              "boolean",
              "dn",
              "time",
              "binary",
              "octet",
              "password"
            ],
            "type": "string"
          },
          "maxLen": {
            "format": "int64",
            "type": "integer"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "noUserModification": {
            "type": "boolean"
          },
          "obsolete": {
            "type": "boolean"
          },
          "oid": {
            "type": "string"
          },
          "ordering": {
            "type": "string"
          },
          "origin": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "singleValue": {
            "type": "boolean"
          },
          "substr": {
            "type": "string"
          },
          "sup": {
            "type": "string"
          },
          "syntax": {
            "description": "Syntax OID, inherited from SUP if not set",
            "type": "string"
          },
          "usage": {
            "enum": [
              "userApplications",
              "directoryOperation",
              "distributedOperation",
              "dSAOperation"
            ],
            "type": "string"
          }
        },
        "required": [
          "oid",
          "names",
          "kind"
        ],
        "type": "object"
      },
      "Capabilities": {
        "additionalProperties": false,
        "properties": {
          "certs": {
            "description": "Management of the NSS certificate database",
            "type": "boolean"
          },
          "files": {
            "description": "Access to logs, LDIF and backup files",
            "type": "boolean"
          },
          "ldapAuth": {
            "description": "How ds-ui authenticates to the server",
            "enum": [
              "sasl-external",
              "simple",
              "anonymous"
            ],
            "type": "string"
          },
          "lifecycle": {
            "description": "Server process control (restart/stop/start)",
            "enum": [
              "docker",
              "s6",
              "none"
            ],
            "type": "string"
          },
          "mode": {
            "enum": [
              "sidecar",
              "remote",
              "aio"
            ],
            "type": "string"
          },
          "offline": {
            "description": "Offline database operations (dsctl)",
            "type": "boolean"
          }
        },
        "required": [
          "mode",
          "ldapAuth",
          "lifecycle",
          "files",
          "certs",
          "offline"
        ],
        "type": "object"
      },
      "ChildrenPage": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Summary"
            },
            "type": "array"
          },
          "nextCursor": {
            "description": "Pass as cursor to get the next page",
            "type": "string"
          },
          "total": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total"
        ],
        "type": "object"
      },
      "Entry": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "items": {
              "$ref": "#/components/schemas/Attribute"
            },
            "type": "array"
          },
          "dn": {
            "type": "string"
          },
          "etag": {
            "description": "Version of the user attributes; send as If-Match when modifying",
            "type": "string"
          },
          "hasChildren": {
            "type": "boolean"
          },
          "numSubordinates": {
            "format": "int64",
            "type": "integer"
          },
          "objectClasses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "parent": {
            "type": "string"
          },
          "rdn": {
            "type": "string"
          }
        },
        "required": [
          "dn",
          "rdn",
          "parent",
          "objectClasses",
          "attributes",
          "numSubordinates",
          "hasChildren",
          "etag"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ObjectClass": {
        "additionalProperties": false,
        "properties": {
          "desc": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "structural",
              "auxiliary",
              "abstract"
            ],
            "type": "string"
          },
          "may": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "must": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "obsolete": {
            "type": "boolean"
          },
          "oid": {
            "type": "string"
          },
          "origin": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sup": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "oid",
          "names",
          "kind",
          "must",
          "may"
        ],
        "type": "object"
      },
      "Schema": {
        "additionalProperties": false,
        "properties": {
          "attributeTypes": {
            "items": {
              "$ref": "#/components/schemas/AttributeType"
            },
            "type": "array"
          },
          "objectClasses": {
            "items": {
              "$ref": "#/components/schemas/ObjectClass"
            },
            "type": "array"
          },
          "syntaxes": {
            "items": {
              "$ref": "#/components/schemas/Syntax"
            },
            "type": "array"
          }
        },
        "required": [
          "attributeTypes",
          "objectClasses",
          "syntaxes"
        ],
        "type": "object"
      },
      "ServerInfo": {
        "additionalProperties": false,
        "properties": {
          "boundAs": {
            "description": "Identity ds-ui is bound as",
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "dbImplementation": {
            "description": "Database implementation (LMDB or Berkeley DB)",
            "enum": [
              "mdb",
              "bdb",
              ""
            ],
            "type": "string"
          },
          "defaultNamingContext": {
            "type": "string"
          },
          "namingContexts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supportedControls": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supportedExtensions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supportedSaslMechanisms": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "vendor": {
            "type": "string"
          },
          "vendorVersion": {
            "type": "string"
          },
          "version": {
            "description": "Parsed product version, e.g. 3.1.2",
            "type": "string"
          }
        },
        "required": [
          "vendor",
          "vendorVersion",
          "version",
          "namingContexts",
          "supportedControls",
          "supportedExtensions",
          "supportedSaslMechanisms",
          "boundAs"
        ],
        "type": "object"
      },
      "Summary": {
        "additionalProperties": false,
        "properties": {
          "dn": {
            "type": "string"
          },
          "exists": {
            "description": "False for a naming context whose root entry has not been created yet",
            "type": "boolean"
          },
          "hasChildren": {
            "type": "boolean"
          },
          "numSubordinates": {
            "format": "int64",
            "type": "integer"
          },
          "objectClasses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "rdn": {
            "type": "string"
          },
          "system": {
            "description": "Server-internal tree such as cn=config",
            "type": "boolean"
          }
        },
        "required": [
          "dn",
          "rdn",
          "objectClasses",
          "numSubordinates",
          "hasChildren",
          "exists"
        ],
        "type": "object"
      },
      "Syntax": {
        "additionalProperties": false,
        "properties": {
          "desc": {
            "type": "string"
          },
          "oid": {
            "type": "string"
          }
        },
        "required": [
          "oid"
        ],
        "type": "object"
      },
      "SystemInfo": {
        "additionalProperties": false,
        "properties": {
          "instance": {
            "description": "389 instance name",
            "type": "string"
          },
          "server": {
            "$ref": "#/components/schemas/ServerInfo"
          },
          "uiVersion": {
            "type": "string"
          }
        },
        "required": [
          "instance",
          "uiVersion",
          "server"
        ],
        "type": "object"
      },
      "SystemState": {
        "additionalProperties": false,
        "properties": {
          "ldap": {
            "description": "Result of an LDAP round-trip",
            "enum": [
              "ok",
              "unreachable",
              "error"
            ],
            "type": "string"
          },
          "ldapError": {
            "type": "string"
          },
          "restartRequired": {
            "description": "A setting changed that only applies after restart",
            "type": "boolean"
          },
          "server": {
            "description": "Process state from the lifecycle provider",
            "enum": [
              "running",
              "stopped",
              "restarting",
              "unknown"
            ],
            "type": "string"
          }
        },
        "required": [
          "ldap",
          "server",
          "restartRequired"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Administration API for 389 Directory Server.",
    "title": "389-ds-ui API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/entries": {
      "get": {
        "operationId": "getEntry",
        "parameters": [
          {
            "description": "Distinguished name of the entry",
            "explode": false,
            "in": "query",
            "name": "dn",
            "required": true,
            "schema": {
              "description": "Distinguished name of the entry",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Entry"
                }
              }
            },
            "description": "OK",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Read one entry with user and operational attributes",
        "tags": [
          "entries"
        ]
      }
    },
    "/api/v1/entries/children": {
      "get": {
        "operationId": "getEntryChildren",
        "parameters": [
          {
            "description": "Parent entry",
            "explode": false,
            "in": "query",
            "name": "dn",
            "required": true,
            "schema": {
              "description": "Parent entry",
              "type": "string"
            }
          },
          {
            "description": "nextCursor from the previous page",
            "explode": false,
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "nextCursor from the previous page",
              "type": "string"
            }
          },
          {
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 200,
              "format": "int64",
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Bypass the short-lived children cache",
            "explode": false,
            "in": "query",
            "name": "refresh",
            "schema": {
              "description": "Bypass the short-lived children cache",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChildrenPage"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Direct children of an entry, sorted by RDN, paged",
        "tags": [
          "entries"
        ]
      }
    },
    "/api/v1/entries/roots": {
      "get": {
        "operationId": "getEntryRoots",
        "parameters": [
          {
            "description": "Include server-internal trees (cn=config, cn=schema, cn=monitor)",
            "explode": false,
            "in": "query",
            "name": "system",
            "schema": {
              "description": "Include server-internal trees (cn=config, cn=schema, cn=monitor)",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Summary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Tree roots: naming contexts and optional system trees",
        "tags": [
          "entries"
        ]
      }
    },
    "/api/v1/schema": {
      "get": {
        "operationId": "getSchema",
        "parameters": [
          {
            "in": "header",
            "name": "If-None-Match",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schema"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Parsed LDAP schema with resolved inheritance",
        "tags": [
          "schema"
        ]
      }
    },
    "/api/v1/system/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Feature groups available in this deployment",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/info": {
      "get": {
        "operationId": "getSystemInfo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Server and UI information",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/system/state": {
      "get": {
        "operationId": "getSystemState",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemState"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Live server state",
        "tags": [
          "system"
        ]
      }
    }
  }
}
