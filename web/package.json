{
  "name": "ds-ui-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node -e \"require('fs').writeFileSync('../internal/webui/dist/.gitkeep','')\"",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:locales": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "naive-ui": "^2.45.3",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  },
  "license": "MIT"
}
